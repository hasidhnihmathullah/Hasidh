<?php
session_start();
require_once 'connection.php'; 

$error   = '';
$success = '';
$tab     = 'login'; 

if ($_SERVER['REQUEST_METHOD'] === 'POST' && isset($_POST['action'])) {
    
    // REGISTER LOGIC
    if ($_POST['action'] === 'register') {
        $tab = 'register';
        $username = trim($_POST['username'] ?? '');
        $gmail    = trim($_POST['email']    ?? ''); // Keeping HTML name as email, but variable as gmail
        $password = $_POST['password']      ?? '';

        if (!empty($username) && !empty($gmail) && !empty($password)) {
            // FIX: Changed email to gmail in the query below
            $check = $conn->prepare("SELECT id FROM users WHERE username = ? OR gmail = ?");
            $check->bind_param("ss", $username, $gmail);
            $check->execute();
            if ($check->get_result()->num_rows > 0) {
                $error = "Username or Gmail already exists.";
            } else {
                // FIX: Changed email to gmail in the INSERT query
                $stmt = $conn->prepare("INSERT INTO users (username, gmail, password) VALUES (?, ?, ?)");
                $stmt->bind_param("sss", $username, $gmail, $password);
                if ($stmt->execute()) {
                    $success = "Account created! You can now Sign In.";
                    $tab = 'login';
                }
                $stmt->close();
            }
            $check->close();
        } else { $error = "All fields are required."; }
    }

    // LOGIN LOGIC
    if ($_POST['action'] === 'login') {
        $tab = 'login';
        $user_input = trim($_POST['username'] ?? '');
        $pass_input = $_POST['password']      ?? '';

        if (!empty($user_input) && !empty($pass_input)) {
            // FIX: Changed email to gmail in the WHERE clause
            $stmt = $conn->prepare("SELECT id, username, password FROM users WHERE username = ? OR gmail = ?");
            $stmt->bind_param("ss", $user_input, $user_input);
            $stmt->execute();
            $res = $stmt->get_result();

            if ($user = $res->fetch_assoc()) {
                if ($pass_input === $user['password']) {
                    $_SESSION['user_id'] = $user['id'];
                    $_SESSION['username'] = $user['username'];
                    header("Location: Velvet.html");
                    exit;
                } else { $error = "Incorrect password."; }
            } else { $error = "User not found."; }
            $stmt->close();
        } else { $error = "Please enter details."; }
    }
}
